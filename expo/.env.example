# Copy this file to `.env` (it's gitignored) and fill in your own keys.
# Every EXPO_PUBLIC_ variable ships inside the app bundle — only put
# client-safe / public keys here. Never the Supabase service_role key.

# Supabase — Project Settings → API (Project URL + "anon" public key).
# The app has working fallbacks hardcoded in services/supabaseConfig.ts,
# so these are only needed if you point Tee at a different project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# GolfCourseAPI — https://golfcourseapi.com (free tier: 50 requests/day).
# Without this, course search / "Find a course" and the nearby suggestion
# are disabled; you can still map courses by hand.
EXPO_PUBLIC_GOLF_COURSE_API_KEY=

# OpenWeatherMap — https://openweathermap.org/api (free tier: 1,000 calls/day).
# Without this, the Smart Caddy falls back to raw distance (no plays-like
# temperature/wind adjustment).
EXPO_PUBLIC_OPENWEATHER_API_KEY=
