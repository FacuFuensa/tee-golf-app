# App Review demo credentials. This repository is public, and a published
# password would let anyone sign in as the reviewer account and wipe its seeded
# data — possibly mid-review.
store/.demo-credentials

# NOTE: package-lock.json is deliberately NOT ignored. This project is built
# with npm, and EAS infers the package manager from whichever lock file it
# finds. `bun.lock` is stale — it still lists @rork-ai/toolkit-sdk and the other
# dependencies removed for the App Store build — so it must be deleted from the
# repo (`git rm bun.lock`) or a cloud build will reinstall them.

# Raw device screenshots. Only the processed 6.9" set is worth versioning —
# run store/prepare-screenshots.py to produce it.
store/screenshots/raw/

# `eas credentials` writes these when exporting the signing certificate for CI.
# credentials.json holds the .p12 password in plain text, and this repo is
# public — the *.p12 / *.p8 rules above do not cover it.
credentials.json
ios/certs/
