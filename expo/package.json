{
  "name": "tee",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "go": "expo start --go --port 8090",
    "go:tunnel": "expo start --go --tunnel --port 8090",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "verify:release": "node store/verify-release.mjs",
    "verify:release:full": "node store/verify-release.mjs --bundle",
    "verify:backend": "node store/verify-backend.mjs",
    "verify:scorecard": "node store/verify-scorecard.mjs",
    "eas": "npx --yes eas-cli@latest",
    "build:ios": "npx --yes eas-cli@latest build --platform ios --profile production",
    "submit:ios": "npx --yes eas-cli@latest submit --platform ios --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@nkzw/create-context-hook": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.83.0",
    "expo": "~54.0.27",
    "expo-constants": "~18.0.11",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.17",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "^0.544.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "axios": "1.13.2"
  }
}
